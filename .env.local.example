# Autonomous Quant Trading Agent - Free VPS Environment
# Copy to .env for Docker/VPS or .env.local for local Next.js development.

# Required auth
DASHBOARD_SECRET="choose_a_strong_dashboard_secret"
ADMIN_SECRET="choose_a_strong_admin_secret"

# Required only if Telegram alerts are enabled by your deployment.
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# Optional free LLM providers. The core trading loop must work without them.
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Optional Supabase free-tier memory.
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_ENABLED="true"

# Redis. Docker Compose uses redis://redis:6379 automatically.
# Local non-Docker development can use redis://127.0.0.1:6379.
REDIS_URL="redis://127.0.0.1:6379"

# Trading configuration
TRADING_TIMEFRAME="1h"
RISK_PER_TRADE="1"
CRON_SECRET=""

# Safety: this project is paper-only by default.
# Exchange keys alone must never trigger live orders.
LIVE_TRADING_ENABLED="false"
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BYBIT_API_KEY=""
BYBIT_API_SECRET=""
MARGIN_MODE="CROSS"

